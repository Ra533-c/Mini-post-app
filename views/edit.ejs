<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="w-full min-h-screen bg-zinc-900 text-white p-10">
        <div class="navbar flex justify-end w-full">
            <a class="bg-red-500 rounded-md hover:bg-red-400 px-3 py-2 text-sm inline-block mb-3" href="/logout">Logout</a>
        </div>
        <h5 class="mb-5 ">Edit your post.🪶</h5>
        <form action="/edit/<%= post._id %>" method="POST">
            <textarea class="block w-1/3 outline-none p-3 resize-none bg-transparent border-1 border-zinc-800 rounded-md" name="content" placeholder="What's on your mind !" required><%= post.content %></textarea>
            <input class="block mt-2 w-40 text-md px-3 py-2 bg-yellow-600 hover:bg-yellow-500 rounded-md font-semibold" type="submit" value="Edit post">
        </form>
    </div>
</body>
</html>