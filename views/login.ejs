<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="flex flex-col justify-center items-center w-full h-screen bg-zinc-900 text-white">
        <h3 class="text-3xl mb-5 font-semibold">Login your account</h3>
        <form class="flex flex-col gap-3 w-80 sm:w-96"  action="/login" method="POST">
            <input class="px-3 py-2 outline-none bg-transparent rounded-md border-1 border-zinc-800" type="email" placeholder="email" name="email" required>
            <input class="px-3 py-2 outline-none bg-transparent rounded-md border-1 border-zinc-800" type="password" placeholder="password" name="password" required>
            <input class="px-3 py-2 outline-none rounded-md bg-blue-500 font-semibold hover:bg-blue-600 " type="submit" value="Login">
        </form>
    </div>
</body>
</html>