<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="w-full min-h-screen bg-zinc-900 text-white p-10">
        <div class="navbar flex justify-end w-full">
            <a class="bg-red-500 rounded-md hover:bg-red-400 px-3 py-2 text-sm inline-block mb-3" href="/logout">Logout</a>
        </div>
        <div class="flex items-start gap-2 mt-3">
            <div class="w-10 h-10 rounded-md">
                <img class="mb-4 w-full h-full object-cover overflow-hidden rounded-md" src="/image/uploads/<%= user.profilepic %>" alt="profilePic">
            </div>
            <h3 class="text-3xl mb-3 font-semibold"><span class="font-light">Hello</span>, <%= user.name %>👋</h3>
        </div>
        <h5 class="mb-5">You can create a new post ✅</h5>
        <form action="/post" method="POST">
            <textarea class="block w-1/3 outline-none p-3 resize-none bg-transparent border-1 border-zinc-800 rounded-md" name="content" placeholder="What's on your mind !" required></textarea>
            <input class="block mt-2 w-40 text-md px-3 py-2 bg-blue-500 hover:bg-blue-600 rounded-md font-semibold" type="submit" value="Create new post">
        </form>
        <div class="posts mt-20">
            <h3 class="text-zinc-400">Your post.</h3>
            <div class="postContainer mt-5">
                <% user.posts.reverse().forEach((post)=>{ %>
                <div class="post w-1/3 p-4 border-1 bg-zinc-800 border-zinc-700 rounded-md mb-4">
                    <h4 class="text-blue-500 mb-2">@<%= user.username %></h4>
                    <p class="text-sm tracking-tight"><%= post.content %></p>
                    <small class="mt-1 inline-block"><%= post.likes.length %> likes</small>
                    <div class="btns flex justify-between">
                        <a class="text-blue-500 hover:text-blue-600 mt-5" href="/like/<%= post._id %>">
                            <%= (post.likes.indexOf(user._id) === -1) ? "Like" : "Dislike" %>
                        </a>
                        <a class="text-zinc-500 hover:text-zinc-400 mt-5" href="/edit/<%= post._id %>">Edit</a>
                    </div>
                </div>
                <% }) %>
            </div>
        </div>
    </div>
</body>
</html>